{
  "name": "grind-strat",
  "version": "0.1.0",
  "private": true,
  "description": "A slow, deep grand strategy game for phones: the Baltic lands from 10,000 BC to today.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"test/*.test.js\"",
    "soak": "node test/soak.mjs",
    "check": "tsc -p tsconfig.json",
    "shots": "node tools/build.mjs && node test/shots.mjs",
    "map": "node tools/map/fetch.mjs && node tools/map/build-grids.mjs && node tools/map/build-test-map.mjs",
    "map:grids": "node tools/map/build-grids.mjs",
    "map:previews": "node tools/map/preview-grids.mjs",
    "map:terrain": "node tools/map/build-terrain-1219.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "typescript": "7.0.2"
  }
}
